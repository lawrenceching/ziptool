{
  "name": "zip-tool-tauri-ui",
  "private": true,
  "description": "Tailwind 预编译与 @tauri-apps/cli 本地打包 (UI 运行时不依赖 node, app.css 产物已提交)",
  "scripts": {
    "css": "tailwindcss -i tailwind/input.css -o ui/app.css --minify",
    "css:watch": "tailwindcss -i tailwind/input.css -o ui/app.css --watch",
    "test": "node --test test/ui.test.mjs",
    "vendor:i18n": "node scripts/vendor-i18n.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "i18next": "26.5.3",
    "jsdom": "^29.1.1"
  }
}
